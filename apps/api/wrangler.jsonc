{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "transfile-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": ["nodejs_compat"],
	"triggers": {
		"crons": ["0 * * * *"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "transfile-db",
			"database_id": "e8479d51-259c-4ae2-8983-7a881907c60c",
			"migrations_dir": "drizzle"
		}
	],
	"r2_buckets": [
		{
			"binding": "FILES",
			"bucket_name": "transfile-files"
		}
	]
}
