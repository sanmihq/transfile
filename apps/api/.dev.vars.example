# Copy to .dev.vars for local development. Leave these empty in git.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
WEB_ORIGIN=
STORAGE_MODE=worker
# S3-compatible storage (Backblaze B2). These are secrets and must never be committed.
# S3_ENDPOINT=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=
# Share-link signing secret. At least 32 characters. Never commit a real value.
SHARE_SECRET=
# Cloudflare Turnstile secret. Empty locally skips verification on http sites.
TURNSTILE_SECRET=
# Optional guest-pool override in bytes. Leave unset to use the 2 GB default.
# GUEST_POOL_BYTES=
